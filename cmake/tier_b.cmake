# Tier B platforms: compile-check core + a stub HAL, no vendor SDK, no board. Included before project().
# Each row: <platform> <profile> <logical W> <logical H> <MCU flags, ";"-free string or empty>
set(_PGE_TIERB_TABLE
  "rp2040|SMALL|160|128|-mcpu=cortex-m0plus -mthumb -mfloat-abi=soft"
  "rp2350|MEDIUM|320|240|-mcpu=cortex-m33 -mthumb -mfpu=fpv5-sp-d16 -mfloat-abi=hard"
  "stm32h7|LARGE|320|240|-mcpu=cortex-m7 -mthumb -mfpu=fpv5-d16 -mfloat-abi=hard"
  "stm32f4_generic|SMALL|160|128|-mcpu=cortex-m4 -mthumb -mfpu=fpv4-sp-d16 -mfloat-abi=hard"
  "esp32|MEDIUM|320|240|")

set(PGE_TIERB OFF)
foreach(_row IN LISTS _PGE_TIERB_TABLE)
  string(REPLACE "|" ";" _f "${_row}")
  list(GET _f 0 _name)
  if(_name STREQUAL PGE_PLATFORM)
    list(GET _f 1 _profile)
    list(GET _f 2 _w)
    list(GET _f 3 _h)
    list(GET _f 4 _flags)
    set(PGE_TIERB ON)
  endif()
endforeach()

if(PGE_TIERB)
  if(_flags)
    set(PGE_MCU_FLAGS "${_flags}")
  else()
    message(STATUS "PGE tier B '${PGE_PLATFORM}': no MCU flags preset; pass your own -DCMAKE_TOOLCHAIN_FILE (Xtensa / ESP-IDF). Unbuilt on the dev machine.")
  endif()
  set(PGE_PROFILE_DIR ${CMAKE_BINARY_DIR}/pge_profile)
  file(WRITE ${PGE_PROFILE_DIR}/pge_profile.h
"#pragma once
// Generated by cmake/tier_b.cmake. Values are ASSUMED, see docs/architecture/01-overview.md section 6.
#define PGE_PROFILE_${_profile} 1
#define PGE_LOGICAL_W ${_w}
#define PGE_LOGICAL_H ${_h}
")
endif()

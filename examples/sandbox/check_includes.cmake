# cmake -DPGE_ROOT=<repo root> -P check_includes.cmake
# Fails if any #include in examples/sandbox/*.h|*.cpp is not "pge/<name>.h" (with <name>.h present in core/include/pge),
# the game's own "game.h", or one of a few C/C++ std headers.
if(NOT PGE_ROOT)
  get_filename_component(PGE_ROOT "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
endif()
file(GLOB files "${PGE_ROOT}/examples/sandbox/*.h" "${PGE_ROOT}/examples/sandbox/*.cpp")
if(NOT files)
  message(FATAL_ERROR "sandbox_includes: no sources found under ${PGE_ROOT}/examples/sandbox")
endif()
set(bad "")
set(count 0)
foreach(f ${files})
  file(STRINGS "${f}" lines REGEX "^[ \t]*#[ \t]*include")
  foreach(l ${lines})
    math(EXPR count "${count}+1")
    string(REGEX REPLACE "^[ \t]*#[ \t]*include[ \t]*" "" inc "${l}")
    string(STRIP "${inc}" inc)
    if(inc MATCHES "^\"pge/([A-Za-z0-9_]+\.h)\"$")
      if(NOT EXISTS "${PGE_ROOT}/core/include/pge/${CMAKE_MATCH_1}")
        list(APPEND bad "${f}: ${l} (no core/include/pge/${CMAKE_MATCH_1})")
      endif()
    elseif(inc MATCHES "^<(stdint\.h|string\.h|cstdio|cstdlib|cstring)>$" OR inc STREQUAL "\"game.h\"")
    else()
      list(APPEND bad "${f}: ${l}")
    endif()
  endforeach()
endforeach()
if(bad)
  string(REPLACE ";" "\n  " msg "${bad}")
  message(FATAL_ERROR "sandbox_includes: forbidden includes:\n  ${msg}")
endif()
message(STATUS "sandbox_includes: ${count} includes checked, all public")
